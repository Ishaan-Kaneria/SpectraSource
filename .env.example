# Copy to .env and fill in. Never commit .env or paste keys in chat.

# Leave empty for a local SQLite file (simplest). docker-compose sets Postgres for its container.
# Postgres outside Docker: postgresql+psycopg://spectra:spectra@localhost:5432/spectra
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API.
# Add your Netlify URL here when the backend is deployed.
CORS_ORIGINS=http://localhost:5173

# mock = no key needed, realistic sample output built from your source (good for UI work and demos).
# gemini = Google Gemini for text, images and video with one key (get it at aistudio.google.com).
# openai_compatible = OpenAI, Groq, Together, vLLM or local Ollama.
LLM_PROVIDER=mock
# Mock only: seconds to pause per deliverable so live per-format progress is visible in demos.
# 0 = instant (tests rely on this); 1.5 works well for a demo.
MOCK_DELAY_SECONDS=0
LLM_API_KEY=
# Optional overrides. Empty uses the provider default
# (gemini: gemini-flash-latest; openai_compatible: api.openai.com + gpt-4o-mini).
LLM_MODEL=
LLM_BASE_URL=
LLM_VISION_MODEL=

# Video/audio via a Whisper-style endpoint instead (OpenAI, Groq). Gemini does not need this.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Local and private, no key:
#   LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1:8b
