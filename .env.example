# Copy to .env and fill in. Never commit .env or paste keys in chat.

# Local dev outside Docker. docker-compose overrides this for the backend container.
DATABASE_URL=postgresql+psycopg://spectra:spectra@localhost:5432/spectra

# Comma-separated list of frontend origins allowed to call the API.
# Add your Netlify URL here when the backend is deployed.
CORS_ORIGINS=http://localhost:5173

# mock = no key needed, placeholder output (good for UI work).
# openai_compatible = OpenAI, Groq, Together, vLLM or local Ollama.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Image input uses a vision-capable model; leave empty to reuse LLM_MODEL.
LLM_VISION_MODEL=
# Video/audio input uses a Whisper-style /audio/transcriptions endpoint (OpenAI, Groq).
# Leave base URL and key empty to reuse the LLM ones.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Local and private, no key:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1:8b
